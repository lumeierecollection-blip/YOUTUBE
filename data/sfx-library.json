  "mixing_rules": {
    "ducking": "Automatically lower music -6dB when voiceover plays",
    "eq_carving": "Cut 300Hz-3kHz in music track by 2-5dB for voice room",
    "compression": "Apply to voiceover for consistent levels",
    "high_pass_music": "Cut below 40Hz",
    "high_pass_voice": "Cut below 80Hz",
    "low_pass_music": "Cut above 10kHz to reduce hiss",
    "test_devices": ["headphones", "phone speaker", "laptop speaker"]
