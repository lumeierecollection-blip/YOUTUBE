{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Stage C output for motion-graphics-style channels. Matches the renderer contract in MOTION-GRAPHICS-MANUAL §8 / DETAIL-REFERENCE §C1-C4. NOTE: as of this rebuild, src/skills/remotion-render/compositions/mg-package.js still derives its own beat/archetype classification from the SRT + prose at render time — it does not yet read sections[].beats from this file. This schema is the target contract (and is what the SCR-03..SCR-08 gates below validate); wiring mg-package.js to prefer these LLM-authored beats over its own classifier is a follow-up, not done as part of this change.",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string"
    },
    "topic_slug": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": [
        "shorts",
        "longform"
      ]
    },
    "hook": {
      "type": "string",
      "minLength": 30,
      "maxLength": 220
    },
    "sections": {
      "type": "array",
      "minItems": 4,
      "maxItems": 7,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "voiceover": {
            "type": "string",
            "minLength": 40
          },
          "beats": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 3
                },
                "archetype": {
                  "type": "string",
                  "enum": [
                    "HERO_NUMBER",
                    "TERM_DEFINE",
                    "LIST_ITEM",
                    "CONTRAST",
                    "PROGRESS",
                    "RELATION",
                    "IMAGE_BEAT",
                    "STATEMENT"
                  ]
                },
                "anchor_token": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "unit": {
                      "type": "string"
                    },
                    "series": {
                      "type": "array",
                      "maxItems": 5,
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string"
                          },
                          "value": {
                            "type": "number"
                          },
                          "highlight": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "label",
                          "value"
                        ]
                      }
                    }
                  }
                },
                "visual": {
                  "description": "The visual direction for this beat - what the viewer should SEE, as opposed to `archetype`, which only says what KIND of beat it is. REQUIRED on every beat: the writer decides the picture, the renderer executes it. This was previously optional and the style contract told the writer to omit it, which left visual/director.js deriving every beat from keywords in the narration - a reader that cannot tell a shock from a footnote, and the reason scripts rendered alike. The deterministic path still exists and still runs when this block is missing or names a strategy the beat's data cannot support, so an omission degrades rather than breaks; it is logged as a real fallback reason (provenance 'deterministic') and shows up in the render's visual report as a drop in `authored plan ratio`. `strategy` must be one of the registered strategies in visual/strategies.js; an unregistered or unrenderable value is rejected at plan time and logged rather than silently ignored.",
                  "type": "object",
                  "properties": {
                    "strategy": {
                      "type": "string",
                      "enum": [
                        "GEOSPATIAL_RADIUS",
                        "ACCUMULATION",
                        "TRANSFORMATION",
                        "PROCESS",
                        "TIMELINE",
                        "DATA_CHART",
                        "COMPARISON",
                        "CAUSE_EFFECT",
                        "RELATIONSHIP",
                        "BEFORE_AFTER",
                        "INTERFACE_SIMULATION",
                        "DOCUMENT_EVIDENCE",
                        "IMAGE_EVIDENCE",
                        "SCALE_COMPARISON",
                        "VISUAL_METAPHOR",
                        "ENUMERATION",
                        "CINEMATIC_STATEMENT"
                      ]
                    },
                    "concept": {
                      "type": "string",
                      "maxLength": 120,
                      "description": "One phrase naming what the viewer should understand from the picture, e.g. 'phones caught inside a 150m warrant boundary'. Diagnostic only — never rendered as on-screen text."
                    },
                    "primary": {
                      "type": "string",
                      "description": "The hero element of the composition."
                    },
                    "secondary": {
                      "type": "array",
                      "maxItems": 3,
                      "items": {
                        "type": "string"
                      }
                    },
                    "data": {
                      "type": "object",
                      "description": "Values the strategy needs that `data` above does not already carry (e.g. from/to for TRANSFORMATION, total/count for ACCUMULATION, stages for PROCESS). Every value here is subject to the same grounding rule as data.series: it must come from the research, never be invented to make a visual work.",
                      "properties": {
                        "value": {
                          "type": "number"
                        },
                        "unit": {
                          "type": "string"
                        },
                        "from": {
                          "type": "number"
                        },
                        "to": {
                          "type": "number"
                        },
                        "total": {
                          "type": "number"
                        },
                        "count": {
                          "type": "number"
                        },
                        "stages": {
                          "type": "number"
                        },
                        "years": {
                          "type": "array",
                          "maxItems": 5,
                          "items": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "strategy"
                  ]
                }
              },
              "required": [
                "text",
                "archetype",
                "anchor_token"
              ]
            }
          },
          "b_roll": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "text_overlay": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "text": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "id",
          "voiceover",
          "beats"
        ]
      }
    },
    "sources_used": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "channel_id",
    "topic_slug",
    "format",
    "hook",
    "sections",
    "sources_used"
  ]
}
