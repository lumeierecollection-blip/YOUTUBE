{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Stage A (discover-topics) output \u2014 one grounded, dated topic per channel, replacing the exhausted content_pillars queue.",
  "type": "object",
  "properties": {
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel_id": {
            "type": "string"
          },
          "topic": {
            "type": "string",
            "minLength": 12,
            "maxLength": 90
          },
          "angle": {
            "type": "string",
            "minLength": 20,
            "maxLength": 320
          },
          "why_now": {
            "type": "string",
            "minLength": 20
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]{8,60}$"
          },
          "pillar": {
            "type": "string"
          },
          "subjects": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            },
            "description": "The specific people and organizations this story is ABOUT, by their full public names as the sources give them (not places, not generic groups like 'police' or 'prosecutors'). scripts/rank-topics-imagery.js looks each one up for a free logo or portrait and puts the best-illustrated candidate first."
          }
        },
        "required": [
          "channel_id",
          "topic",
          "angle",
          "why_now",
          "slug",
          "pillar"
        ]
      }
    }
  },
  "required": [
    "topics"
  ]
}
