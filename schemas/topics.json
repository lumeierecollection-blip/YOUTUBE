{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Stage A (discover-topics) output — one grounded, dated topic per channel, replacing the exhausted content_pillars queue.",
  "type": "object",
  "properties": {
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel_id": { "type": "string" },
          "topic":      { "type": "string", "minLength": 12, "maxLength": 90 },
          "angle":      { "type": "string", "minLength": 20, "maxLength": 160 },
          "why_now":    { "type": "string", "minLength": 20 },
          "slug":       { "type": "string", "pattern": "^[a-z0-9-]{8,60}$" },
          "pillar":     { "type": "string" }
        },
        "required": ["channel_id", "topic", "angle", "why_now", "slug", "pillar"]
      }
    }
  },
  "required": ["topics"]
}
