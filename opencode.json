{
    "$schema":  "https://opencode.ai/config.json",
    "default_agent":  "builder",
    "subagent_depth":  2,
    "permission":  {
                       "websearch":  "allow",
                       "webfetch":  "allow",
                       "external_directory":  "deny",
                       "doom_loop":  "deny"
                   },
    "provider":  {
                     "cerebras":  {
                                      "npm":  "@ai-sdk/openai-compatible",
                                      "name":  "Cerebras",
                                      "options":  {
                                                      "baseURL":  "https://api.cerebras.ai/v1"
                                                  },
                                      "env":  [
                                                  "CEREBRAS_API_KEY"
                                              ],
                                      "models":  {
                                                     "gpt-oss-120b":  {
                                                                          "name":  "GPT-OSS 120B (Cerebras)",
                                                                          "tool_call":  true,
                                                                          "limit":  {
                                                                                        "context":  32000,
                                                                                        "output":  8000
                                                                                    }
                                                                      },
                                                     "zai-glm-4.7":  {
                                                                         "name":  "GLM 4.7 (Cerebras)",
                                                                         "tool_call":  true,
                                                                         "limit":  {
                                                                                       "context":  32000,
                                                                                       "output":  8000
                                                                                   }
                                                                     },
                                                     "gemma-4-31b":  {
                                                                         "name":  "Gemma 4 31B (Cerebras)",
                                                                         "tool_call":  true,
                                                                         "limit":  {
                                                                                       "context":  32000,
                                                                                       "output":  8000
                                                                                   }
                                                                     }
                                                 }
                                  },
                     "groq":  {
                                  "npm":  "@ai-sdk/openai-compatible",
                                  "name":  "Groq",
                                  "options":  {
                                                  "baseURL":  "https://api.groq.com/openai/v1"
                                              },
                                  "env":  [
                                              "GROQ_API_KEY"
                                          ],
                                  "models":  {
                                                 "llama-3.3-70b-versatile":  {
                                                                                 "name":  "Llama 3.3 70B Versatile (Groq)",
                                                                                 "tool_call":  true,
                                                                                 "limit":  {
                                                                                               "output":  32768,
                                                                                               "context":  128000
                                                                                           }
                                                                             },
                                                 "mixtral-8x7b-32768":  {
                                                                            "name":  "Mixtral 8x7B 32K (Groq)",
                                                                            "tool_call":  true,
                                                                            "limit":  {
                                                                                          "output":  32768,
                                                                                          "context":  32768
                                                                                      }
                                                                        }
                                             }
                              },
                     "mistral":  {
                                     "npm":  "@ai-sdk/openai-compatible",
                                     "name":  "Mistral",
                                     "options":  {
                                                     "baseURL":  "https://api.mistral.ai/v1"
                                                 },
                                     "env":  [
                                                 "MISTRAL_API_KEY"
                                             ],
                                     "models":  {
                                                    "mistral-large-latest":  {
                                                                                 "name":  "Mistral Large Latest",
                                                                                 "tool_call":  true,
                                                                                 "limit":  {
                                                                                               "output":  32768,
                                                                                               "context":  128000
                                                                                           }
                                                                             },
                                                    "mistral-small-latest":  {
                                                                                 "name":  "Mistral Small Latest",
                                                                                 "tool_call":  true,
                                                                                 "limit":  {
                                                                                               "output":  32768,
                                                                                               "context":  128000
                                                                                           }
                                                                             }
                                                }
                                 }
                 }
}