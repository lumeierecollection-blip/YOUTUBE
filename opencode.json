{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "mg-orchestrator",
  "subagent_depth": 2,
  "permission": {
    "websearch": "allow",
    "webfetch": "allow",
    "external_directory": "deny",
    "doom_loop": "deny"
  },
  "provider": {
    "cerebras": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cerebras",
      "options": { "baseURL": "https://api.cerebras.ai/v1" },
      "env": ["CEREBRAS_API_KEY"],
      "models": {
        "gpt-oss-120b": {
          "name": "GPT-OSS 120B (Cerebras)",
          "tool_call": true,
          "limit": { "context": 32000, "output": 8000 }
        },
        "zai-glm-4.7": {
          "name": "GLM 4.7 (Cerebras)",
          "tool_call": true,
          "limit": { "context": 32000, "output": 8000 }
        },
        "gemma-4-31b": {
          "name": "Gemma 4 31B (Cerebras)",
          "tool_call": true,
          "limit": { "context": 32000, "output": 8000 }
        }
      }
    }
  }
}
