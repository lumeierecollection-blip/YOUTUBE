  "grammar": {
    "_about": "What the references OBEY, as rules the planner and renderer read. The numbers are in `laws` (measured); these are the structural rules, each observed in the named videos.",
    "rules": [
      {
        "id": "CL-1",
        "rule": "Something new appears on screen on a fixed beat: at least `laws.events_per_10s_min` new elements per 10 s, nine waits in ten no longer than `laws.gap_p90_max_s`, none longer than `laws.gap_max_s`.",
        "seen": "all nine measured references",
        "enforced": "clone-plan.lawProblems on the plan; scripts/gate-clone-cadence.mjs on the rendered pixels"
      },
      {
        "id": "CL-2",
        "rule": "A shot is cut every ~1.4-2.4 s and the cut lands on a spoken word's onset, never mid-word.",
        "seen": "ref-01, ref-03, 4_5764",
        "enforced": "clone-plan.cutPoints"
      },
      {
        "id": "CL-3",
        "rule": "Every shot is dominated by a real picture of the thing being said (photo, portrait, logo, map, figure). Type is secondary: at most 3 display words per shot, popping on the word they are.",
        "seen": "4_5764 (posters, logos, UI), VID_228 (logos, cut-out people), ref-01 (typewriters, scans)",
        "enforced": "clone-plan.lawProblems heroShare >= 0.65; display_words <= 3"
      },
      {
        "id": "CL-4",
        "rule": "Elements of a shot arrive one after another, about 0.35 s apart: ground, picture, accent shape, display words, name plate. Never all at once, never all of one kind.",
        "seen": "ref-03, VID_228",
        "enforced": "clone-plan ELEMENT_OFFSET"
      },
      {
        "id": "CL-5",
        "rule": "Type is mixed in scale within one shot: a small letterspaced label beside one large display word. The display word is the one the sentence turns on; one word may carry the accent.",
        "seen": "ref-01 ('Did u know' + large italic 'typewriter'), ref-03 ('the more you' + 'SLIP AWAY')",
        "enforced": "CloneVideo (label + display roles)"
      },
      {
        "id": "CL-6",
        "rule": "The same picture returns in a different treatment and crop (framed, disc, bleed, strip) rather than a new picture being invented. Never the same frame twice in a row.",
        "seen": "ref-01 (typewriter photo repeats under new type), VID_228 (logo repeats)",
        "enforced": "clone-plan.lawProblems same-frame check"
      },
      {
        "id": "CL-7",
        "rule": "The ground is a paper or a flat tone chosen per profile, and changes between topic blocks; type sits on the ground or on a solid plate, so it is legible by construction.",
        "seen": "ref-03 (cream grid, dark spotlight), 4_5764 (red/black/blue blocks)",
        "enforced": "CloneVideo plate contrast"
      },
      {
        "id": "CL-8",
        "rule": "Text entrances are the pop family only (no bounce, no overshoot, no playful motion): the owner's standing rule for the whole pipeline.",
        "seen": "n/a (owner rule 2026-10-09)",
        "enforced": "CloneVideo uses POP.S0 / POP.IN"
      }
    ],
    "not_cloned": "The references' own subjects, assets, logos and wording. Nothing is copied from the frames: only the rules above."
  }
