{
  "version": 1,
  "channel_id": "ch-26",
  "strategy": "DOCUMENT_EVIDENCE",
  "name": "ch-26-document-evidence-evidence-board",
  "intent": "The actual text of a rule or record, with the operative part found inside it. Here that is court document on a board surface things are pinned to.",
  "environment": {
    "type": "evidence-board",
    "ground": "a board surface things are pinned to",
    "lighting": "raking-side"
  },
  "objects": [
    {
      "object": "court document",
      "role": "subject",
      "anchor": {
        "x": 0.5,
        "y": 0.48,
        "scale": 1.05
      }
    },
    {
      "object": "ledger notebook",
      "role": "supporting",
      "anchor": {
        "x": 0.78,
        "y": 0.8,
        "scale": 0.5
      }
    },
    {
      "object": "wire node",
      "role": "context",
      "anchor": {
        "x": 0.22,
        "y": 0.8,
        "scale": 0.5
      }
    }
  ],
  "camera_path": [
    {
      "at": 0,
      "move": "track-right",
      "reason": "the whole document is in frame so the reader knows what is being quoted from"
    },
    {
      "at": 0.55,
      "move": "push-in",
      "target": "court document",
      "reason": "the camera closes on the operative passage"
    },
    {
      "at": 1,
      "move": "static",
      "reason": "the passage is held long enough to be read"
    }
  ],
  "typography": [
    {
      "slot": "{quote}",
      "face": "secondary",
      "placement": "upper-third",
      "in_at": 0.12,
      "out_at": 1
    }
  ],
  "transitions": [
    {
      "to": "next",
      "type": "map-zoom",
      "duration_frames": 10
    }
  ],
  "parameters": {
    "quote": {
      "type": "text",
      "from": "script-phrase",
      "required": false
    }
  }
}
