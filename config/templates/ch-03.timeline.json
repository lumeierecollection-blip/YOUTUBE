{
  "version": 1,
  "channel_id": "ch-03",
  "strategy": "TIMELINE",
  "name": "ch-03-timeline-screen-interface",
  "intent": "Things happened in an order, laid along a real axis rather than described as a list. Here that is benchmark bar on the flat plane of a display, chrome implied not drawn.",
  "environment": {
    "type": "screen-interface",
    "ground": "the flat plane of a display, chrome implied not drawn",
    "lighting": "screen-glow"
  },
  "objects": [
    {
      "object": "benchmark bar",
      "role": "subject",
      "anchor": {
        "x": 0.5,
        "y": 0.42,
        "scale": 1
      },
      "repeats": "events"
    },
    {
      "object": "cursor pointer",
      "role": "supporting",
      "anchor": {
        "x": 0.2,
        "y": 0.74,
        "scale": 0.7
      }
    },
    {
      "object": "output transcript",
      "role": "context",
      "anchor": {
        "x": 0.8,
        "y": 0.74,
        "scale": 0.7
      }
    }
  ],
  "camera_path": [
    {
      "at": 0,
      "move": "push-in",
      "reason": "the axis is established before anything is placed on it"
    },
    {
      "at": 0.55,
      "move": "high-angle",
      "target": "benchmark bar",
      "reason": "the camera travels the axis in the direction time runs"
    },
    {
      "at": 1,
      "move": "pan-right",
