{
  "version": 1,
  "channel_id": "ch-04",
  "strategy": "CAUSE_EFFECT",
  "name": "ch-04-cause-effect-archive-photo",
  "intent": "One thing drives another and the link between them is drawn, not implied by adjacency. Here that is handwritten letter on the mount board an archival print is laid on.",
  "environment": {
    "type": "archive-photo",
    "ground": "the mount board an archival print is laid on",
    "lighting": "raking-side"
  },
  "objects": [
    {
      "object": "handwritten letter",
      "role": "subject",
      "anchor": {
        "x": 0.5,
        "y": 0.42,
        "scale": 1
      }
    },
    {
      "object": "archival map sheet",
      "role": "supporting",
      "anchor": {
        "x": 0.2,
        "y": 0.74,
        "scale": 0.7
      }
    },
    {
      "object": "archival photograph",
      "role": "context",
      "anchor": {
        "x": 0.8,
        "y": 0.74,
        "scale": 0.7
      }
    }
  ],
  "camera_path": [
    {
      "at": 0,
      "move": "tilt-down",
      "reason": "the cause is alone in frame first"
    },
    {
      "at": 0.55,
      "move": "push-in",
      "target": "handwritten letter",
      "reason": "the camera follows the link across to what it produced"
