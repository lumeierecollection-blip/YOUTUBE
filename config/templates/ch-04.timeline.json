    },
    {
      "object": "date marker",
      "role": "supporting",
      "anchor": {
        "x": 0.2,
        "y": 0.74,
        "scale": 0.7
      }
    },
    {
      "object": "handwritten letter",
      "role": "context",
      "anchor": {
        "x": 0.8,
        "y": 0.74,
        "scale": 0.7
      }
    }
  ],
  "camera_path": [
