{
  "version": 1,
  "channel_id": "ch-04",
  "strategy": "SCALE_COMPARISON",
  "name": "ch-04-scale-comparison-archive-photo",
  "intent": "How big a number is, set against something that gives it size. Here that is museum artifact on the mount board an archival print is laid on.",
  "environment": {
    "type": "archive-photo",
    "ground": "the mount board an archival print is laid on",
    "lighting": "raking-side"
  },
  "objects": [
    {
      "object": "museum artifact",
      "role": "subject",
      "anchor": {
        "x": 0.3,
        "y": 0.5,
        "scale": 0.92
      }
    },
    {
      "object": "archival map sheet",
      "role": "supporting",
      "anchor": {
        "x": 0.7,
        "y": 0.5,
        "scale": 0.92
      }
    },
    {
      "object": "archival photograph",
      "role": "context",
      "anchor": {
        "x": 0.5,
        "y": 0.84,
        "scale": 0.6
      }
    }
  ],
  "camera_path": [
    {
      "at": 0,
