      "type": "document-slide",
      "duration_frames": 18
    }
  ],
  "parameters": {
    "from": {
      "type": "number",
      "from": "script-number",
      "required": true
    },
    "to": {
      "type": "number",
      "from": "script-number",
      "required": true
