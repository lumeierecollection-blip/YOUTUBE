{
  "version": 1,
  "channel_id": "ch-04",
  "strategy": "TRANSFORMATION",
  "name": "ch-04-transformation-archive-photo",
  "intent": "One value becomes another, and the mechanism between them is shown rather than asserted. Here that is handwritten letter on the mount board an archival print is laid on.",
  "environment": {
    "type": "archive-photo",
    "ground": "the mount board an archival print is laid on",
    "lighting": "raking-side"
  },
  "objects": [
    {
      "object": "handwritten letter",
      "role": "subject",
      "anchor": {
        "x": 0.3,
        "y": 0.5,
        "scale": 0.92
      }
    },
    {
      "object": "archival photograph",
      "role": "supporting",
      "anchor": {
        "x": 0.7,
        "y": 0.5,
        "scale": 0.92
      }
    },
    {
      "object": "archival map sheet",
      "role": "context",
      "anchor": {
        "x": 0.5,
        "y": 0.84,
        "scale": 0.6
      }
    }
  ],
  "camera_path": [
    {
      "at": 0,
      "move": "pan-left",
