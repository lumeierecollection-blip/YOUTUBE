{
  "version": 1,
  "channel_id": "ch-09",
  "strategy": "TIMELINE",
  "name": "ch-09-timeline-map-territory",
  "intent": "Things happened in an order, laid along a real axis rather than described as a list. Here that is national border line on a map sheet, terrain seen from altitude.",
  "environment": {
    "type": "map-territory",
    "ground": "a map sheet, terrain seen from altitude",
    "lighting": "flat-overhead"
  },
  "objects": [
    {
      "object": "national border line",
      "role": "subject",
      "anchor": {
        "x": 0.5,
        "y": 0.42,
        "scale": 1
      },
      "repeats": "events"
    },
    {
      "object": "date marker",
      "role": "supporting",
      "anchor": {
        "x": 0.2,
        "y": 0.74,
        "scale": 0.7
      }
    },
    {
      "object": "satellite terrain",
      "role": "context",
      "anchor": {
        "x": 0.8,
        "y": 0.74,
        "scale": 0.7
      }
    }
  ],
  "camera_path": [
    {
      "at": 0,
      "move": "push-in",
      "reason": "the axis is established before anything is placed on it"
    },
    {
      "at": 0.55,
      "move": "pan-right",
      "target": "national border line",
      "reason": "the camera travels the axis in the direction time runs"
    },
    {
      "at": 1,
      "move": "track-left",
      "reason": "the last event lands and the whole span is in frame"
    }
  ],
  "typography": [
    {
      "slot": "{label}",
      "face": "secondary",
      "placement": "corner-overlay",
      "in_at": 0.12,
      "out_at": 1
    }
  ],
  "transitions": [
    {
      "to": "next",
      "type": "territory-fill",
      "duration_frames": 10
    }
  ],
  "parameters": {
    "events": {
      "type": "list",
      "from": "script-list",
      "required": true,
      "max_items": 5
    },
    "label": {
      "type": "text",
      "from": "script-phrase",
      "required": false
    }
  }
}
