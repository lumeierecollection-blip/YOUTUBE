 "sentences": [
  {
   "text": "A 1971 horror drama banned for decades returns in 4K.",
   "start": 0.0,
   "end": 5.5
  },
  {
   "text": "On October 30, 2026, BFI Distribution and Warner Bros.",
   "start": 5.96,
   "end": 10.62
  },
  {
   "text": "Clockwork released the 4K restoration.",
   "start": 10.88,
   "end": 13.06
  },
  {
   "text": "The film stars Oliver Reed and Vanessa Redgrave as Urbain Grandier.",
   "start": 14.2,
   "end": 18.447
  },
  {
   "text": "How many years was it banned before 2026?",
   "start": 18.98,
   "end": 22.313
  },
  {
   "text": "Yet the film vanished from screens for over fifty years.",
   "start": 22.92,
   "end": 26.3
  },
  {
   "text": "The restored cut runs 114 minutes, preserving Ken Russell\u2019s unflinching vision.",
   "start": 26.3,
   "end": 32.76
  },
  {
   "text": "Censors hid it for over fifty years, muting its brutal 17th\u2011century hysteria.",
   "start": 32.76,
   "end": 38.16
  },
  {
   "text": "Now audiences in the UK and Ireland can finally witness the masterpiece.",
   "start": 39.3,
   "end": 43.34
  },
  {
   "text": "The Devils finally returns, restored in full 4K glory.",
   "start": 44.62,
   "end": 48.86
  }
 ]
