          "text": "*35* failure to cooperate",
          "cue": "35"
        }
      }
    },
    {
      "id": "b03",
      "accent": [
        "80",
        "not proven"
      ],
      "text": "The commission proved all 80 financial charges, and 34 of the 35 failure-to-cooperate charges. One charge was not proven.",
      "visual": {
        "type": "clip",
        "shots": [
          "bbc_etihad",
          "tifo_title"
