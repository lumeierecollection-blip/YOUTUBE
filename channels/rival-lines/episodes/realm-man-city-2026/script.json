    {
      "id": "b02",
      "accent": [
        "54",
        "35"
      ],
      "text": "The 115 charges fall into five groups. 54 for inaccurate financial information. 14 for incomplete payments to players and managers. 7 under the league's profitability rules. 5 under UEFA's financial rules. And 35 for failure to cooperate.",
      "visual": {
        "type": "clip",
        "shots": [
          "tifo_all5",
          "tifo_nums"
        ],
        "tag": {
          "right": 120,
