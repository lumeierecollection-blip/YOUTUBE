          "label": "about, in total",
          "cue": "900"
        }
      }
    },
    {
      "id": "b05",
      "accent": [
        "false",
        "accusation"
      ],
      "text": "City deny it. Ferran Soriano, quoted by SportBible, said: The whole Premier League case against us is based on a single false accusation.",
      "visual": {
        "type": "clip",
        "shots": [
          "sky_stmt"
        ],
        "bigcap": {
          "top": 590,
          "text": "“The whole Premier League case against us is based on a single false accusation.”",
          "size": 52,
          "src": "Ferran Soriano, as reported by SportBible",
          "cue": "whole"
        }
      }
    },
    {
      "id": "b06",
      "accent": [
        "unsafe",
        "evidence"
      ],
      "text": "City's lawyers say the commission's opinion contains clear, material errors of law, principle and fact, and that it is unsafe. The club says it has a comprehensive body of irrefutable evidence.",
      "visual": {
        "type": "clip",
        "shots": [
          "bbc_studio"
        ],
        "bigcap": {
          "top": 590,
          "text": "“clear, material errors of law, principle and fact”",
