          "cue": "One"
        }
      }
    },
    {
      "id": "b04",
      "accent": [
        "900",
        "2009"
      ],
      "text": "The financial charges cover the seasons 2009 to 2018. The commission found that sponsors paid less than their contracts stated, and the owners made up the difference. That inflated revenue and cut costs by about 900 million pounds in total.",
      "visual": {
        "type": "clip",
        "shots": [
          "tifo_emails",
          "tifo_pounds"
        ],
        "tag": {
          "right": 120,
          "top": 90,
