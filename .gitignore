youtubetokens.txt
# Local plaintext OAuth client-id/secret scratch file — must NEVER be
# tracked. Untracked and absent from history as of this rule; ignored so a
# broad `git add` can't sweep it in. Real credentials belong only in GitHub
# Actions secrets (CHANNEL_NN_CLIENT_ID / _CLIENT_SECRET / _REFRESH_TOKEN),
# materialized to config/creds/ at run time (also ignored, above).
Oauth.txt
oauth.txt
src/skills/remotion-render/vo.mp3
src/skills/remotion-render/verify-out/
src/skills/remotion-render/out/

# rembg's dedicated venv (asset-sourcing/treat.js) — heavy CPU-inference
# deps (onnxruntime, scikit-image, numba), rebuilt per-machine, never
# committed. See src/skills/asset-sourcing/SKILL.md's Setup section.
.venv-rembg/
# QA verification videos are throwaway evidence for this rebuild's report,
# not pipeline output — the extracted frame PNGs next to them are the part
# worth keeping (same convention as data/renders/**/*.mp4 above).
qa/**/*.mp4
# fetch-library.js's pre-treatment downloads — scratch input to treat.js,
# not pipeline output. The treated copy under
# src/skills/remotion-render/public/asset-library/ plus the manifest row in
# data/asset-library/index.json are what actually matter downstream; the
# raw originals would just bloat the repo with redundant multi-MB images.
data/asset-library/raw/
# Visual-storytelling render tests (qa-scripts/render-visual-tests.sh) stage
# their inputs here. The fixtures themselves are versioned under
# src/skills/remotion-render/qa-scripts/fixtures/; this is scratch staging,
# deliberately kept out of data/research/ so a hand-written fixture can never
# be mistaken for a gate-passed research artifact.
data/audit/visual-tests/
# Scratch stills from scripts/diag-render-frames.mjs (render-layer
# regression tool) — per-run output, never source.
data/audit/diag-frames/

# Short single-beat clips from qa-scripts/render-clip.mjs — same per-run
# output convention as the full renders above.
data/renders/clips/
# Per-beat frames from qa-scripts/mute-test.mjs — regenerated from any
# render on demand, and one set per render adds ~4MB. The frames worth
# keeping are copied up to qa/pass3/ by hand and committed there.
qa/pass3/mute-test/
github token.txt
.artifact-download/
# QA frame dumps from the mograph-critic loop: large, regenerable from
# qa-scripts/inspect-anchors.mjs and qa-scripts/motion-metrics.mjs. The JSON
# reports beside them ARE tracked - those are the evidence.
qa/critic/**/*.png
qa/critic/**/frames/
# QA clip renders (regenerate with the qa-scripts / remocn-demo runners)
data/renders/
client id.txt
dist/
reference-video.mp4
.aider*
