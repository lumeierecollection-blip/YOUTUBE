 "sentences": [
  {
   "text": "Is Lionel Messi the greatest of all time?",
   "start": 0.0,
   "end": 2.74
  },
  {
   "text": "Here is the evidence, in numbers.",
   "start": 3.4,
   "end": 5.16
  },
  {
   "text": "Start with the individual awards: a record eight Ballons d'Or.",
   "start": 5.9,
   "end": 9.6
  },
  {
   "text": "Add to that six European Golden Shoes.",
   "start": 10.04,
   "end": 12.16
  },
  {
   "text": "For Barcelona he scored four hundred and seventy-four La Liga goals, a record, and seventy-three goals in a single season.",
   "start": 12.76,
   "end": 19.52
  },
  {
   "text": "Two trebles with Barcelona, in 2009 and 2015.",
   "start": 20.22,
   "end": 23.5
  },
  {
   "text": "In 2022, he led Argentina to the World Cup.",
   "start": 24.24,
   "end": 27.34
  },
  {
   "text": "In sampled matches, his key passes per ninety minutes more than doubled.",
   "start": 27.34,
   "end": 31.62
  },
  {
   "text": "The greatest of all time: you decide.",
   "start": 32.42,
   "end": 34.76
  }
 ]
