 "sentences": [
  {
   "text": "Is Lionel Messi the greatest of all time?",
   "start": 0.0,
   "end": 2.4
  },
  {
   "text": "Start with the awards: a record eight Ballons d'Or.",
   "start": 3.08,
   "end": 5.907
  },
  {
   "text": "And six European Golden Shoes.",
   "start": 6.48,
   "end": 8.28
  },
  {
   "text": "Four hundred and seventy-four La Liga goals, a record, and seventy-three in a single season.",
   "start": 8.28,
   "end": 14.02
  },
  {
   "text": "Two trebles with Barcelona, in 2009 and 2015.",
   "start": 14.92,
   "end": 17.6
  },
  {
   "text": "In 2022, he led Argentina to the World Cup.",
   "start": 18.6,
   "end": 21.38
  },
  {
   "text": "In sampled matches, his key passes per ninety minutes more than doubled.",
   "start": 22.3,
   "end": 25.44
  },
  {
   "text": "The greatest of all time: you decide.",
   "start": 26.14,
   "end": 28.28
  }
