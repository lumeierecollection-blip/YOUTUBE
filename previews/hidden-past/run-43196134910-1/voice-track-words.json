  {
   "text": "Charles Ponzi promised fifty percent profit in forty-five days.",
   "start": 0.0,
   "end": 4.7
  },
  {
   "text": "To pay everyone, he needed one hundred sixty million coupons, but only twenty-seven thousand existed.",
   "start": 5.42,
   "end": 11.88
  },
  {
   "text": "He paid a crowd two million dollars in three days.",
   "start": 12.62,
   "end": 15.64
  },
  {
   "text": "His bank was seized, and investors lost about twenty million dollars.",
   "start": 16.38,
   "end": 20.5
  },
  {
   "text": "He admitted one of eighty-six fraud counts: five years.",
   "start": 20.92,
   "end": 24.9
  },
  {
   "text": "He died in Rio with seventy-five dollars.",
   "start": 25.58,
   "end": 27.793
  },
  {
   "text": "Would you have invested?",
   "start": 28.24,
   "end": 29.52
  }
