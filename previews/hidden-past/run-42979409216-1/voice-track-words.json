  {
   "text": "On November 27, 1989, a bomb destroys a passenger plane over Colombia.",
   "start": 0.0,
   "end": 5.72
  },
  {
   "text": "Flight 203 leaves Bogot\u00e1.",
   "start": 6.44,
   "end": 8.33
  },
  {
   "text": "Five minutes later, a bomb explodes.",
   "start": 8.86,
   "end": 10.5
  },
  {
   "text": "The plane breaks apart over Soacha.",
   "start": 11.26,
   "end": 13.21
  },
  {
   "text": "All 107 on board die, plus three on the ground.",
   "start": 13.78,
   "end": 17.36
  },
  {
   "text": "Who wanted this?",
   "start": 18.08,
   "end": 18.68
  },
  {
   "text": "Investigators find plastic explosives.",
   "start": 19.9,
   "end": 21.04
  },
  {
   "text": "Pablo Escobar ordered it.",
   "start": 22.2,
   "end": 23.32
  },
  {
   "text": "His target is C\u00e9sar Gaviria.",
   "start": 23.84,
   "end": 25.58
  },
  {
   "text": "But Gaviria is not on the plane.",
   "start": 26.12,
   "end": 27.5
  },
  {
   "text": "He goes on to win the presidency.",
   "start": 28.14,
   "end": 29.28
  },
  {
   "text": "Nine days later, another bomb kills sixty-three in Bogot\u00e1.",
   "start": 29.95,
   "end": 33.25
  },
  {
   "text": "A bomb meant for one man killed 110.",
   "start": 33.74,
   "end": 36.08
  }
 ]
