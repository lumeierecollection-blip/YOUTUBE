 "sentences": [
  {
   "text": "In 1989, a bomb destroys a plane over Colombia.",
   "start": 0.0,
   "end": 3.64
  },
  {
   "text": "Flight 203 leaves Bogot\u00e1.",
   "start": 4.28,
   "end": 5.99
  },
  {
   "text": "Five minutes later, a bomb explodes.",
   "start": 6.46,
   "end": 8.34
  },
  {
   "text": "The plane breaks apart over Soacha.",
   "start": 9.08,
   "end": 10.92
  },
  {
   "text": "All 107 on board die, and three people on the ground.",
   "start": 11.44,
   "end": 14.82
  },
  {
   "text": "Who wanted this?",
   "start": 15.5,
   "end": 16.14
  },
  {
   "text": "Pablo Escobar's Medell\u00edn Cartel ordered it.",
   "start": 17.0,
   "end": 19.18
  },
  {
   "text": "His target is C\u00e9sar Gaviria.",
   "start": 19.56,
   "end": 21.44
  },
  {
   "text": "But Gaviria is not on the plane.",
   "start": 22.02,
   "end": 23.58
  },
  {
   "text": "Nine days later, another bomb kills sixty-three in Bogot\u00e1.",
   "start": 24.48,
   "end": 27.59
  },
  {
   "text": "A 2016 report disputes the cause, but families reject it.",
   "start": 27.98,
   "end": 31.96
  },
  {
   "text": "A bomb meant for one man killed 110.",
   "start": 32.52,
   "end": 34.82
  }
 ]
