  {
   "text": "Pablo Escobar planned a bomb for a presidential candidate.",
   "start": 0.0,
   "end": 4.0
  },
  {
   "text": "An Avianca jet takes off from Bogot\u00e1.",
   "start": 4.74,
   "end": 7.06
  },
  {
   "text": "It is bound for Cali.",
   "start": 7.5,
   "end": 9.05
  },
  {
   "text": "Five minutes later, a bomb explodes.",
   "start": 9.6,
   "end": 11.7
  },
  {
   "text": "The plane breaks apart over Soacha.",
   "start": 12.64,
   "end": 14.7
  },
  {
   "text": "107 die on board, three on the ground.",
   "start": 15.26,
   "end": 18.38
  },
  {
   "text": "The target is C\u00e9sar Gaviria.",
   "start": 19.12,
   "end": 21.1
  },
  {
   "text": "But Gaviria is not on the plane.",
   "start": 21.52,
   "end": 23.5
  },
  {
   "text": "Nine days later, another bomb kills 63.",
   "start": 24.4,
   "end": 26.86
  },
  {
   "text": "A 2016 report disputes the cause, but families reject it.",
   "start": 27.52,
   "end": 31.98
  },
  {
   "text": "A bomb meant for one man killed 110.",
   "start": 32.58,
   "end": 35.28
  }
