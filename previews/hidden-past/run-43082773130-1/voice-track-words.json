  {
   "text": "Al Capone ruled Chicago's Prohibition underworld.",
   "start": 0.0,
   "end": 3.86
  },
  {
   "text": "In 1929, seven rival gangsters were murdered in broad daylight.",
   "start": 5.04,
   "end": 10.22
  },
  {
   "text": "Newspapers called him Public Enemy Number One.",
   "start": 11.0,
   "end": 13.9
  },
  {
   "text": "Agents turned to income tax.",
   "start": 14.66,
   "end": 16.44
  },
  {
   "text": "Twenty-two counts of tax evasion.",
   "start": 16.44,
   "end": 18.98
  },
  {
   "text": "His own admissions of income became evidence.",
   "start": 19.84,
   "end": 22.2
  },
  {
   "text": "Five convictions, eleven years.",
   "start": 23.18,
   "end": 25.24
  },
  {
   "text": "He died in 1947.",
   "start": 25.24,
   "end": 27.6
  },
  {
   "text": "Taxes ended his reign.",
   "start": 28.68,
   "end": 29.96
