    },
    {
      "text": "Twenty-two counts of tax evasion.",
      "scene": 4,
      "claim_ids": [
        "K5"
      ]
    },
    {
      "text": "His own admissions of income became evidence.",
      "scene": 5,
      "claim_ids": [
        "K6"
