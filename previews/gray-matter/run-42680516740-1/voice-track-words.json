 "sentences": [
  {
   "text": "A sleepless night makes new things harder to remember.",
   "start": 0.0,
   "end": 4.88
  },
  {
   "text": "The hippocampus, deep in the temporal lobe, helps form memories.",
   "start": 6.04,
   "end": 10.92
  },
  {
   "text": "One imaging study found it less active during learning.",
   "start": 11.84,
   "end": 15.38
  },
  {
   "text": "In mice, five hours awake cut dendritic spines, the receiving side of connections.",
   "start": 16.32,
   "end": 23.66
  },
  {
   "text": "Blocking cofilin, which breaks down actin, prevented the loss.",
   "start": 24.28,
   "end": 29.38
  },
  {
   "text": "Recovery sleep reversed it, but only in mice.",
   "start": 30.42,
   "end": 34.3
  }
 ]
