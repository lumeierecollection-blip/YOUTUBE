 "sentences": [
  {
   "text": "A sleepless night worsens memory for new things.",
   "start": 0.0,
   "end": 4.46
  },
  {
   "text": "The hippocampus, deep in the temporal lobe, helps form memories.",
   "start": 5.34,
   "end": 10.04
  },
  {
   "text": "One imaging study found it less active when learning.",
   "start": 10.98,
   "end": 14.1
  },
  {
   "text": "In mice, five hours awake cut dendritic spines.",
   "start": 14.9,
   "end": 19.2
  },
  {
   "text": "Blocking cofilin, which breaks down actin, prevented the loss.",
   "start": 20.04,
   "end": 24.04
  },
  {
   "text": "Recovery sleep reversed it, only in mice.",
   "start": 25.28,
   "end": 27.98
  }
 ]
