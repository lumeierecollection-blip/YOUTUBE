 "sentences": [
  {
   "text": "A sleepless night makes learning harder.",
   "start": 0.0,
   "end": 3.28
  },
  {
   "text": "The hippocampus, in the temporal lobe, helps form memories.",
   "start": 4.38,
   "end": 8.88
  },
  {
   "text": "One imaging study found it less active when learning.",
   "start": 9.82,
   "end": 13.32
  },
  {
   "text": "In mice, five hours awake cut dendritic spines.",
   "start": 14.0,
   "end": 18.34
  },
  {
   "text": "Blocking cofilin, which breaks down actin, prevented the loss.",
   "start": 19.32,
   "end": 23.74
  },
  {
   "text": "Recovery sleep reversed it, only in mice.",
   "start": 24.9,
   "end": 28.1
  }
 ]
