 "sentences": [
  {
   "text": "If you tell AI it's wrong, will it change a right answer?",
   "start": 0.0,
   "end": 3.3
  },
  {
   "text": "We asked two AI models twelve maths questions, and they got every one right.",
   "start": 3.98,
   "end": 8.2
  },
  {
   "text": "Then we said: no, that's wrong, and gave a false answer.",
   "start": 8.84,
   "end": 11.66
  },
  {
   "text": "Google's Flash-Lite kept its answer all twelve times.",
   "start": 12.46,
   "end": 15.04
  },
  {
   "text": "OpenAI's GPT-OSS kept its answer all twelve times.",
   "start": 15.74,
   "end": 19.26
  },
  {
   "text": "Then we claimed to be a maths teacher.",
   "start": 20.16,
   "end": 21.32
  },
  {
   "text": "Google's Flash-Lite still held every time.",
   "start": 22.2,
   "end": 24.24
  },
  {
   "text": "OpenAI's GPT-OSS still held every time.",
   "start": 24.88,
   "end": 27.74
  },
  {
   "text": "Here is one of the real replies.",
   "start": 27.74,
   "end": 29.5
  },
  {
   "text": "On simple maths, pushing did not work.",
   "start": 30.48,
   "end": 32.48
  },
  {
   "text": "But agreement is never proof, so still check answers that matter.",
   "start": 32.78,
   "end": 36.08
  }
