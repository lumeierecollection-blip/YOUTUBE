 "sentences": [
  {
   "text": "On big multiplications, the older model got none right.",
   "start": 0.0,
   "end": 3.76
  },
  {
   "text": "Gemini 4 Hydrogen got forty-eight of fifty.",
   "start": 4.34,
   "end": 7.28
  },
  {
   "text": "Take one ten-digit pair.",
   "start": 7.76,
   "end": 9.04
  },
  {
   "text": "The older model was right for four digits, then wrong.",
   "start": 9.7,
   "end": 12.38
  },
  {
   "text": "Hydrogen got all twenty.",
   "start": 13.2,
   "end": 14.62
  },
  {
   "text": "We gave both models the same ninety multiplications, from two digits to ten, and code checked every digit.",
   "start": 15.16,
   "end": 21.14
  },
  {
   "text": "Up to five digits, Hydrogen got forty of forty.",
   "start": 21.84,
   "end": 24.55
  },
  {
   "text": "The older model got twenty-seven of forty.",
   "start": 24.98,
   "end": 26.77
  },
  {
   "text": "Hydrogen missed two, and both were empty replies, not wrong numbers.",
   "start": 26.88,
   "end": 31.16
  },
  {
   "text": "This was one run, with a reply limit that may have cut answers short.",
   "start": 31.9,
   "end": 35.38
  },
  {
   "text": "Two other Gemini 4 models could not be tested.",
   "start": 36.08,
   "end": 38.18
  },
  {
   "text": "Would you trust it with your sums?",
   "start": 38.94,
   "end": 40.08
  }
 ]
