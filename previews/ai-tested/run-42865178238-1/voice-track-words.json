 "sentences": [
  {
   "text": "Why do some AI models fail at counting letters?",
   "start": 0.0,
   "end": 3.2
  },
  {
   "text": "We asked two models twenty questions, twice.",
   "start": 3.98,
   "end": 6.62
  },
  {
   "text": "Once plainly, once with one change: spell it out first.",
   "start": 7.56,
   "end": 11.16
  },
  {
   "text": "A real reply: it spells the word, then counts.",
   "start": 11.94,
   "end": 14.9
  },
  {
   "text": "Asked plainly, Google's Flash-Lite got sixteen right.",
   "start": 14.9,
   "end": 18.74
  },
  {
   "text": "Spelling first, twenty.",
   "start": 19.54,
   "end": 20.64
  },
  {
   "text": "On random letters, six of ten became ten.",
   "start": 21.4,
   "end": 24.18
  },
  {
   "text": "OpenAI's GPT-OSS was perfect either way.",
   "start": 24.92,
   "end": 27.86
  },
  {
   "text": "Why?",
   "start": 27.86,
   "end": 28.78
  },
  {
   "text": "Models read tokens, not letters.",
   "start": 29.24,
   "end": 31.32
  },
  {
   "text": "Strawberry is one tokens, but ten letters.",
   "start": 32.48,
   "end": 34.84
  },
  {
   "text": "Same models, same questions, one change.",
   "start": 35.94,
   "end": 38.16
  },
  {
   "text": "So make the model spell it out first.",
   "start": 38.96,
   "end": 40.68
  }
 ]
