 "sentences": [
  {
   "text": "If you ask AI for a source, will the link work?",
   "start": 0.0,
   "end": 3.0
  },
  {
   "text": "We asked three AI models for a link on twelve topics, then clicked every single one.",
   "start": 3.72,
   "end": 8.9
  },
  {
   "text": "Each one had to give a news article or a study.",
   "start": 9.38,
   "end": 11.76
  },
  {
   "text": "Google's Gemini Flash gave three dead links out of twelve.",
   "start": 12.56,
   "end": 15.53
  },
  {
   "text": "Google's Flash-Lite gave four dead links out of twelve.",
   "start": 15.9,
   "end": 18.7
  },
  {
   "text": "OpenAI's GPT-OSS gave five dead links out of twelve.",
   "start": 19.12,
   "end": 22.62
  },
  {
   "text": "That is twelve dead links out of thirty-six.",
   "start": 22.9,
   "end": 25.44
  },
  {
   "text": "Here is one real answer.",
   "start": 26.14,
   "end": 27.48
  },
  {
   "text": "This one was about the invention of the World Wide Web.",
   "start": 27.48,
   "end": 29.84
  },
  {
   "text": "A dead link looks exactly like a working one.",
   "start": 30.48,
   "end": 33.06
  },
  {
   "text": "How many links have you trusted unclicked?",
   "start": 33.54,
   "end": 35.72
  }
 ]
