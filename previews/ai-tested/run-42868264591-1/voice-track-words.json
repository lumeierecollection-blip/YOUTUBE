 "sentences": [
  {
   "text": "Why do some AI models fail at counting letters?",
   "start": 0.0,
   "end": 2.96
  },
  {
   "text": "We asked two models twenty questions, once plainly, once spelling it out first.",
   "start": 3.68,
   "end": 8.36
  },
  {
   "text": "A real reply: it spells the word, then counts.",
   "start": 9.02,
   "end": 11.86
  },
  {
   "text": "Asked plainly, Google's Flash-Lite got sixteen right.",
   "start": 12.86,
   "end": 16.16
  },
  {
   "text": "Spelling first, twenty.",
   "start": 16.8,
   "end": 17.88
  },
  {
   "text": "On random letters, six of ten became ten.",
   "start": 18.64,
   "end": 21.3
  },
  {
   "text": "OpenAI's GPT-OSS was perfect either way.",
   "start": 21.3,
   "end": 24.92
  },
  {
   "text": "Why: models read tokens, not letters.",
   "start": 25.54,
   "end": 28.22
  },
  {
   "text": "Strawberry is one tokens, but ten letters.",
   "start": 28.22,
   "end": 31.52
  },
  {
   "text": "Same models, same questions, one change.",
   "start": 32.5,
   "end": 34.66
  },
  {
   "text": "So make the model spell it out first.",
   "start": 35.4,
   "end": 37.04
  }
 ]
