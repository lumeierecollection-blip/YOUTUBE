{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scene plan",
  "type": "object",
  "required": ["channel", "production_run", "scenes"],
  "properties": {
    "channel": { "type": "string" },
    "production_run": { "type": "string" },
    "format": { "type": "string" },
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "narration", "main_point", "visual_objective", "treatment", "background", "skill", "assets", "animation", "on_screen_text", "claim_ids", "transition"],
        "properties": {
          "scene_id": { "type": "string" },
          "narration": { "type": "string", "description": "The exact words spoken during this scene." },
          "main_point": { "type": "string" },
          "visual_objective": { "type": "string", "description": "What the viewer learns from the picture." },
          "treatment": { "type": "string", "description": "A treatment id from the channel's SCENES." },
          "background": { "type": "string", "description": "white for explanatory graphics; otherwise what the subject calls for." },
          "skill": { "type": "string", "description": "The specialist component that produces this scene." },
          "assets": { "type": "array", "items": { "type": "object", "required": ["id", "origin"], "properties": { "id": { "type": "string" }, "origin": { "type": "string" }, "licence": { "type": "string" }, "source_url": { "type": "string" } } } },
          "animation": { "type": "string" },
          "on_screen_text": { "type": "array", "items": { "type": "string" } },
          "claim_ids": { "type": "array", "items": { "type": "string" } },
          "data_sources": { "type": "array", "items": { "type": "string" } },
          "transition": { "type": "string" },
          "start_s": { "type": "number" },
          "end_s": { "type": "number" }
        }
      }
    }
  }
}
