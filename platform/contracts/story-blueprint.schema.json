{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Story blueprint",
  "type": "object",
  "required": ["central_question", "thesis", "why_it_matters", "viewer_start", "viewer_end", "key_evidence", "beats", "questions_raised", "conclusion"],
  "properties": {
    "central_question": { "type": "string" },
    "thesis": { "type": "string" },
    "why_it_matters": { "type": "string" },
    "viewer_start": { "type": "string", "description": "What the viewer knows at the beginning." },
    "viewer_end": { "type": "string", "description": "What the viewer must understand by the end." },
    "key_evidence": { "type": "array", "items": { "type": "string", "description": "claim_id" } },
    "beats": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "required": ["beat_id", "role", "purpose", "claim_ids", "link_from_previous"],
        "properties": {
          "beat_id": { "type": "string" },
          "role": { "enum": ["opening", "context", "development", "payoff", "ending"] },
          "purpose": { "type": "string", "description": "How this beat serves the central question." },
          "claim_ids": { "type": "array", "items": { "type": "string" } },
          "link_from_previous": { "enum": ["none", "cause", "consequence", "chronology", "comparison", "contradiction", "explanation", "discovery", "evidence", "change_over_time"] }
        }
      }
    },
    "questions_raised": {
      "type": "array",
      "items": { "type": "object", "required": ["question", "raised_in", "answered_in"], "properties": { "question": { "type": "string" }, "raised_in": { "type": "string" }, "answered_in": { "type": "string" } } }
    },
    "conclusion": { "type": "string" }
  }
}
