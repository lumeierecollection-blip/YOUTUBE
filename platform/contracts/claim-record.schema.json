{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claim record",
  "type": "object",
  "required": ["claim_id", "claim", "source_id", "source_url", "excerpt", "confidence", "editorial_status"],
  "properties": {
    "claim_id": { "type": "string" },
    "claim": { "type": "string" },
    "source_id": { "type": "string" },
    "source_url": { "type": "string" },
    "published": { "type": ["string", "null"] },
    "excerpt": { "type": "string", "description": "The passage in the source that supports the claim." },
    "confidence": { "enum": ["high", "medium", "low"] },
    "context": { "type": "string" },
    "contradictory_evidence": { "type": "array", "items": { "type": "string" } },
    "editorial_status": { "type": "string", "description": "One of the channel's claim_categories in the registry." }
  }
}
